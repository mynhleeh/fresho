# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Word/Office lock files
~$*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test

# database
*.db
*.db-journal

# vercel
.vercel

# agent scratch workspace (subagent-driven-development)
/.superpowers/
/docs/superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts

/requirement/

# setup script's change-detection cache
/.cache/

# uploaded farm photos are sensitive user data; keep only the seed sample
/public/uploads/batches/*
!/public/uploads/batches/seed-mango.jpg

/img/