generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  address    String
  passwordHash String @default("") @map("password_hash")
  role       String
  trustScore Int      @default(0) @map("trust_score")
  createdAt  DateTime @default(now()) @map("created_at")

  batches            HarvestBatch[]
  preOrders          PreOrder[]
  assignedDeliveries DeliveryRecord[] @relation("LogisticsPartner")
  raisedDisputes     DisputeLog[]
  ratingsGiven       Rating[]         @relation("Rater")
  ratingsReceived    Rating[]         @relation("Ratee")
  savedBatches       SavedBatch[]

  @@map("users")
}

model Rating {
  id               String   @id @default(cuid())
  preOrderId       String   @map("pre_order_id")
  preOrder         PreOrder @relation(fields: [preOrderId], references: [id])
  raterId          String   @map("rater_id")
  rater            User     @relation("Rater", fields: [raterId], references: [id])
  rateeId          String   @map("ratee_id")
  ratee            User     @relation("Ratee", fields: [rateeId], references: [id])
  qualityScore     Int      @map("quality_score")
  timelinessScore  Int      @map("timeliness_score")
  commitmentScore  Int      @map("commitment_score")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([preOrderId, raterId])
  @@map("ratings")
}

model HarvestBatch {
  id                   String      @id @default(cuid())
  farmerId             String      @map("farmer_id")
  farmer               User        @relation(fields: [farmerId], references: [id])
  cropName             String      @map("crop_name")
  quantityTotal        Int         @map("quantity_total")
  quantityAvailable    Int         @map("quantity_available")
  unit                 String
  pricePerUnit         Int         @map("price_per_unit")
  harvestDateEstimate  DateTime    @map("harvest_date_estimate")
  status               String      @default("open")
  photoUrl             String?     @map("photo_url")
  location             String      @default("")
  qualityStandard      String?     @map("quality_standard")
  minOrderQuantity     Int         @default(1) @map("min_order_quantity")
  description          String?     @map("description")
  createdAt            DateTime    @default(now()) @map("created_at")

  preOrders        PreOrder[]
  progressUpdates  HarvestProgressUpdate[]
  savedBy          SavedBatch[]

  @@map("harvest_batches")
}

model SavedBatch {
  id        String       @id @default(cuid())
  batchId   String       @map("batch_id")
  batch     HarvestBatch @relation(fields: [batchId], references: [id])
  buyerId   String       @map("buyer_id")
  buyer     User         @relation(fields: [buyerId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([batchId, buyerId])
  @@map("saved_batches")
}

model HarvestProgressUpdate {
  id            String       @id @default(cuid())
  batchId       String       @map("batch_id")
  batch         HarvestBatch @relation(fields: [batchId], references: [id])
  farmerId      String       @map("farmer_id")
  kind          String
  note          String?
  previousValue String?      @map("previous_value")
  newValue      String?      @map("new_value")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("harvest_progress_updates")
}

model PreOrder {
  id               String         @id @default(cuid())
  batchId          String         @map("batch_id")
  batch            HarvestBatch   @relation(fields: [batchId], references: [id])
  buyerId          String         @map("buyer_id")
  buyer            User           @relation(fields: [buyerId], references: [id])
  quantity         Int
  pricePerUnit     Int            @map("price_per_unit")
  deliveryMethod   String         @default("self_pickup") @map("delivery_method")
  shippingFeeQuote Int?           @map("shipping_fee_quote")
  status           String         @default("pending_confirmation")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  deposits      Deposit[]
  settlement    Settlement?
  ledgerEntries LedgerEntry[]
  delivery      DeliveryRecord?
  disputes      DisputeLog[]
  messages      OrderMessage[]
  ratings       Rating[]

  @@map("pre_orders")
}

model ShippingQuote {
  id                 String   @id @default(cuid())
  batchId            String   @map("batch_id")
  buyerId            String   @map("buyer_id")
  quantity           Int
  distanceKm         Int      @map("distance_km")
  vehicleType        String   @map("vehicle_type")
  estimatedFee       Int      @map("estimated_fee")
  pickupWindow       String   @map("pickup_window")
  storageRequirement String   @map("storage_requirement")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("shipping_quotes")
}

model OrderMessage {
  id         String   @id @default(cuid())
  preOrderId String   @map("pre_order_id")
  preOrder   PreOrder @relation(fields: [preOrderId], references: [id])
  senderId   String   @map("sender_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("order_messages")
}

model Deposit {
  id         String   @id @default(cuid())
  preOrderId String   @map("pre_order_id")
  preOrder   PreOrder @relation(fields: [preOrderId], references: [id])
  amount     Int
  status     String   @default("paid")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("deposits")
}

model Settlement {
  id                  String   @id @default(cuid())
  preOrderId          String   @unique @map("pre_order_id")
  preOrder            PreOrder @relation(fields: [preOrderId], references: [id])
  finalQuantity       Int      @map("final_quantity")
  finalGoodsAmount    Int      @map("final_goods_amount")
  shippingFee         Int      @map("shipping_fee")
  finalPaymentAmount  Int      @map("final_payment_amount")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("settlements")
}

model LedgerEntry {
  id         String   @id @default(cuid())
  preOrderId String   @map("pre_order_id")
  preOrder   PreOrder @relation(fields: [preOrderId], references: [id])
  type       String
  amount     Int
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("ledger_entries")
}

model DeliveryRecord {
  id                 String         @id @default(cuid())
  preOrderId         String   @unique @map("pre_order_id")
  preOrder           PreOrder @relation(fields: [preOrderId], references: [id])
  logisticsPartnerId String?  @map("logistics_partner_id")
  logisticsPartner   User?    @relation("LogisticsPartner", fields: [logisticsPartnerId], references: [id])
  method             String
  status             String   @default("ready_for_handover")
  trackingNote       String?  @map("tracking_note")
  actualQuantity     Int?     @map("actual_quantity")
  proofPhotoUrl      String?  @map("proof_photo_url")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@map("delivery_records")
}

model DisputeLog {
  id             String        @id @default(cuid())
  preOrderId     String        @map("pre_order_id")
  preOrder       PreOrder      @relation(fields: [preOrderId], references: [id])
  raisedById     String   @map("raised_by_id")
  raisedBy       User     @relation(fields: [raisedById], references: [id])
  reason         String
  resolutionNote String?  @map("resolution_note")
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("dispute_logs")
}
